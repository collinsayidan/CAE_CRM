# CAE CRM settings. Copy this file to .env for local use (.env is never committed),
# and add the same names in Vercel under Settings -> Environment Variables.

# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Use the pooler, not the direct connection: Vercel can't reach Supabase's direct (IPv6-only) address.
# Replace [YOUR-PASSWORD] with the database password. Leave empty locally to use a SQLite file instead.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Vercel preview deployments (one per pull request) never use DATABASE_URL. Give them their own database:
# a second Supabase project's Transaction pooler string, set in Vercel for the Preview environment only.
PREVIEW_DATABASE_URL=

# Signs sign-in cookies. A long random value; changing it signs everyone out. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAE_SECRET_KEY=

# Invite code people must enter to create a new workspace. Leave empty to let anyone sign up.
CAE_SETUP_CODE=

# Set to 1 locally for auto-reload and error pages. Never on Vercel.
FLASK_DEBUG=0

# Email through Resend (resend.com). Leave empty and the app still works; it just can't send email.
# API key: Resend -> API Keys -> Create (Sending access is enough).
RESEND_API_KEY=
# The address every business sends from, on a domain you've verified in Resend -> Domains.
# Each email shows the business's own name, and replies go to its reply-to address (set under Settings).
CAE_MAIL_FROM=hello@mail.yourdomain.co.uk
# Optional: lets Resend report deliveries, opens, clicks, bounces and spam complaints back to CAE CRM.
# Resend -> Webhooks -> Add endpoint https://<your site>/webhooks/resend, then copy its signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=

# Billing through Stripe (stripe.com). Leave STRIPE_SECRET_KEY empty and billing is off: every workspace has full access.
# Secret key: Stripe -> Developers -> API keys (use sk_test_... until you're ready to take real payments).
STRIPE_SECRET_KEY=
# The recurring price per user: Stripe -> Product catalogue -> add "CAE CRM", a recurring monthly price in GBP. Copy its price_... id.
STRIPE_PRICE_ID=
# Stripe -> Developers -> Webhooks -> add https://<your site>/webhooks/stripe for the customer.subscription.* and
# checkout.session.completed events, then copy its signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Optional: a 20% UK VAT tax rate (Stripe -> Product catalogue -> Tax rates, exclusive). Copy its txr_... id.
STRIPE_TAX_RATE_ID=
# Price per user a month in pence, shown in the app. Keep it the same as the Stripe price.
CAE_SEAT_PRICE=1500
CAE_TRIAL_DAYS=14
# Workspace ids that never pay, comma-separated (your own business, for example).
CAE_BILLING_EXEMPT=

# Integrations. Each appears under Integrations once its client id and secret are set.
# Redirect URI to register with each service: https://<your site>/integrations/<google|microsoft|xero|hmrc>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# The Xero sales account code invoices are posted to (200 is "Sales" in Xero's default UK chart).
XERO_SALES_ACCOUNT=200
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# sandbox (HMRC's test service) until HMRC approves you for production.
HMRC_ENV=sandbox
# Optional: your server's public IP, sent to HMRC in the Gov-Vendor-Public-IP fraud prevention header.
CAE_VENDOR_PUBLIC_IP=
# Vercel Cron sends this as a bearer token to /cron/sync. Any long random value.
CRON_SECRET=
# Docker hosts (Coolify): the site's public address, used by `python cron.py` for links in the emails it sends.
CAE_BASE_URL=
# Docker hosts: gunicorn worker processes (default 2).
CAE_WORKERS=
# Optional: Companies House lookups. A free key from developer.company-information.service.gov.uk (a REST key).
COMPANIES_HOUSE_API_KEY=
# Optional: email-to-ticket. The domain (or <id>.resend.app address) where Resend receives email for CAE CRM.
CAE_INBOUND_DOMAIN=
# Optional: a separate key for encrypting integration tokens. Defaults to one derived from CAE_SECRET_KEY.
CAE_TOKEN_KEY=

# Error monitoring with Sentry (sentry.io). Create a Flask project and copy its DSN. Leave empty to switch off.
# Reports never include form contents, cookies or sign-in headers; people are identified by number only.
SENTRY_DSN=
# Optional: share of requests to time for performance monitoring, 0 to 1 (0.1 = one in ten).
SENTRY_TRACES_SAMPLE_RATE=0

# File attachments. Optional: without these, files are kept in the database, which suits small teams.
# To use Supabase Storage, create a private bucket (Storage > New bucket, Public off) and copy the project URL and
# the service_role key from Project Settings > API. Keep the service_role key secret: it bypasses all access rules.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# The bucket's name, if it isn't "attachments".
CAE_STORAGE_BUCKET=attachments

# Homepage "Book a demo" button: the address of a web form in your own CAE CRM workspace (Marketing > Forms), so demo
# requests arrive as leads. Must start with https:// or /. Leave empty to hide the button.
CAE_DEMO_URL=

# Legal pages (/legal). Details left empty show on the pages as highlighted "to confirm" notes.
LEGAL_COMPANY_NAME=Collinalitics Ltd
LEGAL_COMPANY_NUMBER=
LEGAL_ADDRESS=
LEGAL_ICO_NUMBER=
LEGAL_EMAIL=
# For example: England and Wales, or Scotland
LEGAL_LAW=
# The Supabase project's region, for example: London (eu-west-2)
LEGAL_DATA_REGION=
# Set to 1 once a solicitor has reviewed the documents, to remove the "Draft" notice.
CAE_LEGAL_REVIEWED=
